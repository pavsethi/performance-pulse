# Copy to .env and fill in. .env is gitignored — never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
# PULSE_MODEL=claude-opus-5-5
# PULSE_EFFORT=high

# The app always calls https://api.anthropic.com, deliberately ignoring any
# ANTHROPIC_BASE_URL already set in your shell — managed machines often pin
# that to a corporate gateway, which will reject a personal sk-ant- key with
# a 403. Set this only if you want the calls to go somewhere else.
# PULSE_BASE_URL=https://api.anthropic.com
